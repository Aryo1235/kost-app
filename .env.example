# Salin ke .env, lalu isi. Berkas .env tidak masuk git.

# PostgreSQL lokal (docker/compose.dev.yml). Tes memakai kost_test.
DATABASE_URL=postgres://kost:kost@127.0.0.1:5432/kost_dev

# Alamat resmi aplikasi. Dipakai pemeriksaan Origin dan cookie.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Penandatangan tautan file. Buat dengan: openssl rand -base64 48
FILE_SIGNING_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Penyimpanan file privat. Harus di luar folder public.
STORAGE_DIR=./storage

# Zona waktu proses (BR-13).
TZ=Asia/Jakarta
